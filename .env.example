# Local development only. Copy to .env (git-ignored) and replace every change-me value.
# docker compose reads this file for variable substitution; `npm run dev` loads it with
# Node's --env-file-if-exists flag. No API or LLM keys are needed in this phase.

# --- PostgreSQL container (docker compose) ---
POSTGRES_DB=pheme
# Bootstrap superuser: used by the image's init scripts and for local admin work, never by the server.
POSTGRES_USER=pheme_admin
POSTGRES_PASSWORD=change-me-admin-password
# Password of the least-privilege pheme_app role. Applied only when the data volume is first created.
PHEME_APP_DB_PASSWORD=change-me-app-password
# Host port for PostgreSQL, published on 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# --- Server (npm run dev) ---
# Use 127.0.0.1 rather than localhost (Node may try IPv6 ::1 first) and percent-encode special
# characters in the password. Must match PHEME_APP_DB_PASSWORD and POSTGRES_HOST_PORT above.
DATABASE_URL=postgres://pheme_app:change-me-app-password@127.0.0.1:5432/pheme
LOG_LEVEL=info
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_MAX=5
